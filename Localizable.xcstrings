      }
    },
    "Applite couldn't open %@" : {
      "comment" : "App couldn't be opened alert",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Applite n’a pas pu ouvrir %@"
          }
        },
        "hu" : {
          "stringUnit" : {
